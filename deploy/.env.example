# Copy to deploy/.env on the server and edit. deploy/.env is never committed.
# No secrets are needed until Phase 6 (accounts).

# Addresses. Both stacks use the same host name; the one that does not hold the main
# address sits on a port (8443 or 8444 are published). No extra DNS records are needed.
#
#   before cutover:  SITE_NEW=neomortalsurv.net:8443   SITE_LEGACY=neomortalsurv.net
#   after cutover:   SITE_NEW=neomortalsurv.net        SITE_LEGACY=neomortalsurv.net:8444
#
# (With DNS records for subdomains, names such as staging.neomortalsurv.net work here
# just as well.)
SITE_NEW=neomortalsurv.net:8443

# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=

# Old Streamlit app behind the same Caddy: on | off
LEGACY=on
SITE_LEGACY=neomortalsurv.net
# Where Streamlit listens on the host (see docs/CUTOVER.md, step 3).
LEGACY_UPSTREAM=host.docker.internal:8501

# Kazakh interface: false until the clinical review is confirmed.
VITE_ENABLE_KK=false

RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
