# Copy to deploy/.env on the server and edit. deploy/.env is never committed.
# No secrets are needed until Phase 6 (accounts).

# Address served by the new stack. Staging first; the main domain at cutover.
SITE_NEW=staging.neomortalsurv.net

# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=

# Old Streamlit app behind the same Caddy: on | off
LEGACY=on
# Before cutover the old app keeps the main domain; after cutover it moves to legacy.
SITE_LEGACY=neomortalsurv.net
# Where Streamlit listens on the host (see docs/CUTOVER.md, step 3).
LEGACY_UPSTREAM=host.docker.internal:8501

# Kazakh interface: false until the clinical review is confirmed.
VITE_ENABLE_KK=false

RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
